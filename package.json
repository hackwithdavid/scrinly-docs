{
  "name": "scrinly-api-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Public documentation for the Scrinly Browser API",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "mint dev --no-open",
    "validate": "mint validate --telemetry=false",
    "links": "mint broken-links --check-anchors --check-redirects --telemetry=false",
    "a11y": "mint a11y --telemetry=false",
    "audit": "node scripts/audit.mjs",
    "test": "npm run validate && npm run links && npm run a11y && npm run audit"
  },
  "devDependencies": {
    "mint": "4.2.804"
  }
}
